# Copy to .env and fill in.
# Each value here is consumed by api-server, sorrel, mockup-sandbox or scripts.

# --- Postgres ----------------------------------------------------------------
# Local example: postgresql://postgres:postgres@localhost:5432/sorrel_dev
DATABASE_URL=

# --- Render queue (Redis) ----------------------------------------------------
# Optional. When set, renders run through a durable BullMQ queue + in-process
# worker that survives restarts. When BLANK, renders run inline (fire-and-forget)
# — fine for local dev; the app works without Redis (mirrors SENTRY_DSN/RESEND).
# Local example: redis://localhost:6379
REDIS_URL=
# Render worker concurrency (Chrome + FFmpeg is heavy). Defaults to 1.
RENDER_CONCURRENCY=
# Parallel render workers per job (producer `workers`). Defaults to 2. The producer
# otherwise auto-calibrates to host CPUs (~6 on Railway) and OOM-crashes a small
# container. Set 1 on a <1GB box; raise on a bigger one for faster renders.
RENDER_WORKERS=
# Render job retry attempts. Defaults to 1 (render failures are usually deterministic).
RENDER_JOB_ATTEMPTS=

# --- Website → Video capture -------------------------------------------------
# The website→video feature screenshots a user-supplied URL in headless Chrome.
# Chrome's sandbox is ON by default (we load untrusted pages). Some container
# hosts (running as root with no user namespaces) can't start a sandboxed Chrome
# — set this to "true" THERE (and only there) to launch with --no-sandbox.
CAPTURE_NO_SANDBOX=
# Explicit Chrome binary for the capture. Locally, leave blank — puppeteer uses
# its downloaded Chrome. In the Docker image the capture reuses the system
# chromium via PRODUCER_HEADLESS_SHELL_PATH / PUPPETEER_EXECUTABLE_PATH, so this
# override is rarely needed (set it only to pin a specific binary).
CAPTURE_CHROME_PATH=

# Used by future session signing flows (rotation, signed cookies).
# Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# --- Process configuration ---------------------------------------------------
# api-server, Vite frontend, mockup-sandbox each need their own port.
PORT=8080
# Vite base path. Leave as / for local development.
BASE_PATH=/

# --- CORS / app URL ----------------------------------------------------------
# Production only: comma-separated allowed origins, full URLs.
# Example: https://app.sorrel.video,https://www.sorrel.video
ALLOWED_ORIGINS=
# Public URL for webhook registration in the Stripe Dashboard.
# Local example: http://localhost:8080
APP_URL=http://localhost:8080

# --- Stripe ------------------------------------------------------------------
# Secret API key (server-side only).
STRIPE_SECRET_KEY=
# Optional — only required if the frontend needs to read it.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. Register the endpoint at ${APP_URL}/api/billing/webhook
# in the Stripe Dashboard, then paste the signing secret here.
STRIPE_WEBHOOK_SECRET=

# --- Object storage (Google Cloud Storage) -----------------------------------
# Pick ONE auth mode:
#   (a) GCS_SERVICE_ACCOUNT_KEY — base64-encoded service-account JSON.
#       Best for container deployments. Example:
#         GCS_SERVICE_ACCOUNT_KEY=$(base64 -i service-account.json)
#   (b) GOOGLE_APPLICATION_CREDENTIALS — path to a service-account JSON file.
#       Best for VMs / local dev where the file lives on disk.
#   (c) Application Default Credentials (no env) — `gcloud auth
#       application-default login` for local dev, or workload identity in
#       GKE / Cloud Run / Cloud Build.
GCS_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# GCP project id. Required in modes (b) and (c); inferred from the JSON in
# mode (a) if absent here.
GCS_PROJECT_ID=
# Bucket paths used by ObjectStorageService — see CLAUDE.md.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# --- Email (Resend) ----------------------------------------------------------
# Used by /api/auth/signup, /api/auth/forgot-password, etc. When empty in dev,
# emails are logged to stdout instead of being sent.
RESEND_API_KEY=
# RFC 5322 From header. Set to a domain you have verified in Resend.
# Example: "Sorrel <noreply@sorrel.video>"
EMAIL_FROM=

# --- OAuth (optional — leave blank to hide provider buttons) -----------------
# Configure these in each provider's developer console, with callback URL
# ${APP_URL}/api/auth/oauth/<provider>/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI (LLM provider) -------------------------------------------------------
# Pick one of: anthropic | openai. Only the matching API key is required.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# Optional model override; defaults to gpt-4o-mini.
OPENAI_MODEL=
# Auto-captions (Track E2) transcribe via OpenAI Whisper. Reuses OPENAI_API_KEY
# above by default; set WHISPER_API_KEY only to use a SEPARATE key for captions.
# Unset (and no OPENAI_API_KEY) → the "Auto-caption" action is hidden and
# POST /captions/generate returns 503.
WHISPER_API_KEY=

# --- Live Avatar (real-time conversational avatar — Pro, optional) -----------
# Real-time HeyGen LiveAvatar (POST /api/avatar/session-token mints a short-lived
# token server-side; the browser SDK opens the WebRTC stream). Unset → the Live
# Avatar page + endpoint are disabled (503). Sandbox by default (NO credit
# consumption) — set LIVEAVATAR_SANDBOX=false for live, metered sessions.
LIVEAVATAR_API_KEY=
# Optional overrides (default to the SDK's reference sandbox avatar/voice/context):
LIVEAVATAR_API_URL=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_CONTEXT_ID=
LIVEAVATAR_LANGUAGE=
LIVEAVATAR_SANDBOX=

# --- Distributed render (AWS Lambda — Pro tier, optional) --------------------
# Fans a render out across AWS Lambda + Step Functions (the @workspace/infra CDK
# app provisions the AWS side — see infra/README.md). This is SEPARATE from the
# Railway container and from GCS object storage; Hyperframes streams all frame
# chunks + the final MP4 through an S3 bucket, and the api-server POLLS progress
# (there are no completion webhooks). UNSET → no Lambda: renders use the existing
# inline / BullMQ path. Single-region, SDR-only in v1.
#
# Route renders to Lambda. Leave blank (or `local`) to keep the inline/BullMQ
# path; set to `lambda` to use the distributed backend.
RENDER_BACKEND=
# Single-region target for the render fleet. Required when RENDER_BACKEND=lambda.
# Example: us-east-1
AWS_REGION=
# Access key for the least-privilege `sorrel-render-runtime-<stage>` IAM user
# the CDK stack creates (drive one state machine + read/delete its S3 artifacts).
# Mint the key out-of-band; never commit it. See infra/README.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 render bucket name — the `RenderBucketName` CfnOutput from `cdk deploy`.
HYPERFRAMES_S3_BUCKET=
# Chromium source for the render Lambda (drives package size, ≤248MiB unzipped):
#   @sparticuz/chromium  → ~70MiB  (default)
#   chrome-headless-shell → ~140MiB
HYPERFRAMES_LAMBDA_CHROME_SOURCE=@sparticuz/chromium
# Max parallel render Lambdas. Defaults to 8.
HYPERFRAMES_LAMBDA_CONCURRENCY=
# Per-job frame cap — cost guard so one render can't fan out unboundedly.
RENDER_MAX_FRAMES=
# How often the api-server polls getRenderProgress (ms). No webhooks; must poll.
# Example: 3000
LAMBDA_PROGRESS_POLL_MS=
# Per-account cap on concurrent/total distributed renders (Pro-tier gate).
DISTRIBUTED_RENDER_LIMIT=
# BUILD-TIME ONLY (not read by the api-server): absolute path to a Hyperframes
# repo checkout. The CDK/SAM build reads the Lambda render runtime from here.
HYPERFRAMES_REPO_ROOT=
