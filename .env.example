# Copy to .env and fill in.
# Each value here is consumed by api-server, sorrel, mockup-sandbox or scripts.

# --- Postgres ----------------------------------------------------------------
# Local example: postgresql://postgres:postgres@localhost:5432/sorrel_dev
DATABASE_URL=

# Used by future session signing flows (rotation, signed cookies).
# Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# --- Process configuration ---------------------------------------------------
# api-server, Vite frontend, mockup-sandbox each need their own port.
PORT=8080
# Vite base path. Leave as / for local development.
BASE_PATH=/

# --- CORS / app URL ----------------------------------------------------------
# Production only: comma-separated allowed origins, full URLs.
# Example: https://app.sorrel.video,https://www.sorrel.video
ALLOWED_ORIGINS=
# Public URL for webhook registration in the Stripe Dashboard.
# Local example: http://localhost:8080
APP_URL=http://localhost:8080

# --- Stripe ------------------------------------------------------------------
# Secret API key (server-side only).
STRIPE_SECRET_KEY=
# Optional — only required if the frontend needs to read it.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. Register the endpoint at ${APP_URL}/api/billing/webhook
# in the Stripe Dashboard, then paste the signing secret here.
STRIPE_WEBHOOK_SECRET=
