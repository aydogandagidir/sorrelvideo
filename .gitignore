# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
**/coverage/
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# pnpm/build cache
.cache/
.local/

# environment
.env
.env.local
.env.*.local

# Hyperframes core runtime artifact (copied from @hyperframes/core/dist at
# setup time; regenerated, not source). See scripts/setup-hyperframes-runtime.
core/

# Rendered output (mp4 + per-render composition.html), any location.
**/renders/
.tmp-frames/

# Per-user Studio composition workspaces (M9): HTML the embedded editor
# reads/writes via /api/studio/*. Runtime data like renders/, never source.
artifacts/api-server/studio-workspaces/

# Production SPA bundle staged for the api-server to serve (copied from
# artifacts/sorrel/dist/public by the Dockerfile / single-port local serve).
artifacts/api-server/public/

# Playwright browser-smoke artifacts (artifacts/sorrel/e2e). Run output, not source.
artifacts/sorrel/test-results/
artifacts/sorrel/playwright-report/
