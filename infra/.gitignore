# CDK synth output (CloudFormation templates + assets). Regenerated by
# `cdk synth`/`cdk deploy`; never committed. node_modules / *.tsbuildinfo are
# already covered by the repo-root .gitignore.
cdk.out/
*.cdk.staging/

# CDK CLI local context cache (account/region/AZ lookups). Account-specific.
cdk.context.json
