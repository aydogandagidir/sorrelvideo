# Production env template. DO NOT commit the filled-in version.
# See DEPLOYMENT.md for where each value comes from.

NODE_ENV=production
PORT=8080
BASE_PATH=/

# --- Postgres (Railway: link from Postgres plugin) --------------------------
DATABASE_URL=

# --- Render queue + persistent volume (Railway) -----------------------------
# Recommended: link a Redis plugin so renders run on a durable BullMQ queue that
# survives restarts (without it renders run inline; a restart mid-render fails
# that project, auto-recovered on boot).
REDIS_URL=
# Mount a Railway Volume at /data and point BOTH dirs at it so user output
# survives deploys — the container FS is otherwise ephemeral and every push
# auto-ships. RENDERS_DIR = rendered mp4s; STUDIO_WORKSPACE_DIR = compositions
# authored in the embedded Studio editor (unset → wiped + re-seeded blank on each
# deploy, looks like data loss). See DEPLOYMENT.md.
RENDERS_DIR=/data/renders
STUDIO_WORKSPACE_DIR=/data/studio-workspaces

# --- Session signing --------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- App URLs / CORS --------------------------------------------------------
APP_URL=https://app.your-domain.com
ALLOWED_ORIGINS=https://app.your-domain.com,https://your-domain.com

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google Cloud Storage ---------------------------------------------------
# Base64-encoded service-account JSON.
GCS_SERVICE_ACCOUNT_KEY=
GCS_PROJECT_ID=
PUBLIC_OBJECT_SEARCH_PATHS=/sorrel-public
PRIVATE_OBJECT_DIR=/sorrel-private/uploads

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=Sorrel <noreply@your-domain.com>

# --- OAuth (optional — leave blank to hide buttons) -------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI provider ------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5   # uncomment to override
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Observability ----------------------------------------------------------
# Sentry (backend, runtime) — leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry (frontend SPA) — BUILD-TIME, not runtime. Vite inlines `import.meta.env.VITE_*`
# when the SPA is bundled inside the Docker image, so these must be present at
# BUILD time. On Railway they reach the build because matching service variables
# are injected into the Dockerfile as ARGs (see Dockerfile build stage) — set
# them in the Railway service Variables tab like any other var. Leaving them empty
# disables frontend error tracking (the browser Sentry SDK no-ops).
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_GIT_SHA is set automatically by deploy.yml to the deploy commit (so the
# frontend Sentry release matches GIT_SHA). Only set it by hand for a manual
# `railway up` from your laptop. Leave blank otherwise.
VITE_GIT_SHA=

# Logs: the app writes structured JSON (Pino) to stdout; Railway captures it.
# To ship logs to Better Stack / Logtail use a Railway native LOG DRAIN
# (Railway → Project → Settings → Log drains), NOT an in-process transport —
# there is no LOGTAIL_SOURCE_TOKEN env var. See DEPLOYMENT.md §6.
LOG_LEVEL=info

# --- Release tracking -------------------------------------------------------
# GIT_SHA tags the backend Sentry release. deploy.yml sets it (+ VITE_GIT_SHA)
# from github.event.workflow_run.head_sha. Leave blank for local runs.
GIT_SHA=
