# Production env template. DO NOT commit the filled-in version.
# See DEPLOYMENT.md for where each value comes from.

NODE_ENV=production
PORT=8080
BASE_PATH=/

# --- Postgres (Railway: link from Postgres plugin) --------------------------
DATABASE_URL=

# --- Session signing --------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- App URLs / CORS --------------------------------------------------------
APP_URL=https://app.your-domain.com
ALLOWED_ORIGINS=https://app.your-domain.com,https://your-domain.com

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google Cloud Storage ---------------------------------------------------
# Base64-encoded service-account JSON.
GCS_SERVICE_ACCOUNT_KEY=
GCS_PROJECT_ID=
PUBLIC_OBJECT_SEARCH_PATHS=/sorrel-public
PRIVATE_OBJECT_DIR=/sorrel-private/uploads

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=Sorrel <noreply@your-domain.com>

# --- OAuth (optional — leave blank to hide buttons) -------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI provider ------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5   # uncomment to override
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Observability ----------------------------------------------------------
# Sentry — leave empty to disable.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Better Stack / Logtail — leave empty to keep stdout-only logging.
LOGTAIL_SOURCE_TOKEN=
LOG_LEVEL=info

# --- Release tracking -------------------------------------------------------
# GitHub Actions deploy.yml sets this from github.event.workflow_run.head_sha.
GIT_SHA=
